    <BrokenSprite texture="%ModDir%/Content/Items/Bureaucracy/salaryenvelope_broken.png" sourcerect="0,0,49,79" depth="0.8" origin="0.5,0.5" maxcondition="1" />
    <Body width="45" height="65" density="8" />
    <MeleeWeapon slots="Any,RightHand+LeftHand" aimpos="40,-30" handle1="-10,0" handle2="-15,10" aimangle="-80" holdangle="30" msg="ItemMsgPickUpSelect">
      <StatusEffect type="OnSecondaryUse" target="This" Condition="-25.0">
