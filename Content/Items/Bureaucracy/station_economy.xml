      </StatusEffect>
      <StatusEffect type="OnBroken" target="This" allowaccess="true">
        <Sound file="Content/Items/Medical/ITEM_proteinBarOpen.ogg" range="350" />
      </StatusEffect>
    </MeleeWeapon>
    <ItemContainer capacity="8" containedstateindicatorslot="0" ShowConditionInContainedStateIndicator="true">
      <Containable items="erc_salaryenvelope_small">
        <StatusEffect type="OnContaining" targettype="This" interval="1" allowaccess="false">
          <Conditional condition="gt 0" />
        </StatusEffect>
      </Containable>
    </ItemContainer>
    <Deconstruct time="1" />
  </Item>

