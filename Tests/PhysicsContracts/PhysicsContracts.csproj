<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GameDirectory Condition="'$(GameDirectory)' == ''">C:/Steam/steamapps/common/Barotrauma</GameDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Farseer.NetStandard"><HintPath>$(GameDirectory)/Farseer.NetStandard.dll</HintPath></Reference>
    <Reference Include="XNATypes"><HintPath>$(GameDirectory)/XNATypes.dll</HintPath></Reference>
    <Compile Include="../../CSharp/Shared/Interactions/StaticFixtureTranslation.cs" Link="Production/StaticFixtureTranslation.cs" />
    <Compile Include="../../CSharp/Shared/Interactions/LiveItemTransform.cs" Link="Production/LiveItemTransform.cs" />
  </ItemGroup>
</Project>
